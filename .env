# =============================================================================
# Dockerized Laravel - .env template
# The installer fills the {{PLACEHOLDERS}}. Everything dock reads is in the
# "Docker" section; the rest is a regular Laravel .env.
# =============================================================================

APP_NAME="{{APP_NAME}}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL="http://localhost:8000"

APP_TIMEZONE=Europe/Rome
APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

# -----------------------------------------------------------------------------
# Docker (read by ./dock)
# -----------------------------------------------------------------------------
# Prefix for every container: myapp, myapp-db, myapp-redis, ...
CONTAINER_NAME="{{CONTAINER_NAME}}"

# artisan (dev) | octane (FrankenPHP) | nginx | caddy (auto HTTPS) | fpm
SERVER=artisan

# Optional, comma separated: redis,mailpit,meilisearch,phpmyadmin,soketi,gotenberg
SERVICES=

# Host port of the app (artisan/octane/nginx; caddy uses HTTP_PORT/HTTPS_PORT)
APP_PORT=8000

# Deploy: branch pulled by ./dock deploy, public domain for Caddy HTTPS
BRANCH=main
DOMAIN=

# Bind mounts. Relative paths are relative to the project root; prefer
# absolute paths on servers (e.g. /var/data/myapp/storage).
STORAGE_MOUNT_PATH=./storage
DB_MOUNT_PATH=./db-data

# Interface for DB/Redis/Mailpit/... host ports. Keep 127.0.0.1 on servers.
# SERVICES_BIND=127.0.0.1
# FORWARD_DB_PORT=3306          # host-side DB port (container port never changes)
# FORWARD_REDIS_PORT=6379

# Image versions (rebuild with ./dock start --build after changing)
# PHP_VERSION=8.5
# NODE_VERSION=24
# PHP_EXTENSIONS="imagick soap"   # extra PHP extensions
# FRANKENPHP_VERSION=1.13.0
# Database images are pinned; bump deliberately (major = dump/restore):
# MARIADB_VERSION=11.4  POSTGRES_VERSION=16.15  PGVECTOR_VERSION=0.8.7-pg17

# Container user, written by ./dock deploy. Defaults to your UID/GID.
# USER_ID=1000
# GROUP_ID=1000

# -----------------------------------------------------------------------------
# Database
# DB_DRIVER: mariadb | postgres | pgvector (PostgreSQL + vector extension)
# postgres/pgvector: DB_CONNECTION=pgsql, DB_HOST=postgres, DB_PORT=5432
# -----------------------------------------------------------------------------
DB_DRIVER=mariadb
DB_CONNECTION=mysql
DB_HOST=mariadb
DB_PORT=3306
DB_DATABASE="{{DB_NAME}}"
DB_USERNAME=app
DB_PASSWORD="{{DB_PASSWORD}}"
# DB_ROOT_PASSWORD=          # MariaDB root (defaults to DB_PASSWORD)

# -----------------------------------------------------------------------------
# Cache, session, queue
# -----------------------------------------------------------------------------
CACHE_STORE=file
SESSION_DRIVER=file
SESSION_LIFETIME=120
QUEUE_CONNECTION=database

LOG_CHANNEL=daily
LOG_LEVEL=debug

# SERVICES=redis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# SERVICES=mailpit
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
