# =============================================================================
# Docker build context exclusions
# Keep the build context small and host secrets/state out of the image
# =============================================================================

# Secrets / config (mounted at runtime instead)
.env
.env.*
!.env.example
auth.json.local

# VCS
.git
.gitignore
.gitattributes

# IDE / OS
.idea
.vscode
.DS_Store
*.swp
*.swo

# Dependencies (rebuilt inside container)
node_modules
vendor

# Build artifacts
public/build
public/hot
public/storage
storage/app/public/*
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
storage/logs/*
bootstrap/cache/*.php
!storage/**/.gitkeep

# Tests / docs
tests
phpunit.xml
README*.md
CHANGELOG*.md

# Tooling / temp
.tmp
.phpunit.result.cache
.phpunit.cache
npm-debug.log
yarn-error.log
*.log

# Docker toolkit + runtime data (mounted at runtime, never baked in).
# db-data must stay out: the DB files are unreadable to the build and huge.
/docker
/dock
/db-data
/backups
docker-compose*.yml
