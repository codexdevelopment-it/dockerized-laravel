# =============================================================================
# Caddy + PHP-FPM
# Automatic HTTPS (Let's Encrypt) when DOMAIN is a real public domain.
# =============================================================================

{$DOMAIN:localhost} {
    root * /var/www/html/public
    encode gzip zstd

    # Block direct access to any php other than /index.php
    @blockPhp {
        path *.php
        not path /index.php
    }
    respond @blockPhp 404

    # Only allow index.php to be executed by PHP-FPM
    @onlyIndex path /index.php

    php_fastcgi @onlyIndex app:9000 {
        index index.php
    }

    file_server

    # Laravel handle all other routes via index.php internally
    try_files {path} /index.php?{query}

    header {
        X-Frame-Options "SAMEORIGIN"
        X-Content-Type-Options "nosniff"
        -Server
    }

    log {
        output file /data/access.log {
            roll_size 20mb
            roll_keep 5
        }
        format json
    }
}
